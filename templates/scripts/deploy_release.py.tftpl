#!/usr/bin/env python3
"""Promote a build artifact to the production release channel."""
import json
import subprocess
import sys

RELEASE_BUCKET = "prod-release-artifacts"
REGISTRY = "123456789012.dkr.ecr.us-east-1.amazonaws.com/services"

${credentials}


def promote(version):
    print(f"Promoting {version} to {RELEASE_BUCKET}")
    subprocess.run(
        ["aws", "s3", "cp", f"build/{version}.tar.gz",
         f"s3://{RELEASE_BUCKET}/{version}/"],
        check=True,
    )


if __name__ == "__main__":
    promote(sys.argv[1] if len(sys.argv) > 1 else "latest")
